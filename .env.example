# OpenAI: chat model for every step, and gpt-image-1 for images. The key's project must
# allow gpt-image-1 (platform.openai.com > Settings > Project > Limits) and the
# organization must be verified, or image requests fail.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search for the Deep Research agent (https://serpapi.com).
SERPAPI_API_KEY=

# Optional: folder for generated images (default: outputs, relative to where the server runs).
# IMAGE_OUTPUT_DIR=outputs

# Optional: LangSmith tracing. Runs work with these unset.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=content-agent
